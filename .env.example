# Copy to .env to override defaults. Every value is optional.

# Port on your machine (http://localhost:HOST_PORT)
HOST_PORT=3000

# Port the server listens on inside the container
PORT=3000

# Number of stored messages sent to a client when it connects
HISTORY_LIMIT=100

# Interval (ms) between server pings used to detect dead connections
WS_HEARTBEAT_MS=30000
